{
	// Display name shown in VS Code's Dev Containers UI.
	"name": "git-worktrees-devcontainer",

	// Keep the environment simple and reproducible by using the published base image directly.
	// Pinning the Ubuntu version avoids surprising changes from a floating tag.
	// To customize the toolchain per branch, edit this "image" value inside that
	// branch's copy of devcontainer.json, or switch to a Dockerfile / Compose-based
	// setup. Creating an arbitrary .devcontainer/image file does nothing unless
	// your configuration explicitly reads it.
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

	// The Linux user VS Code connects as inside the container.
	// Using the non-root 'vscode' user avoids common bind-mount permission issues.
	"remoteUser": "vscode",

	// ── WORKTREE LAYOUT ─────────────────────────────────────────────────────────
	// This setup expects the main repository and all linked worktrees to live as
	// siblings under one shared parent directory:
	//   /parent/my-project
	//   /parent/agent-1
	//   /parent/agent-2
	//
	// Why this matters:
	// A linked worktree stores a .git FILE whose contents point back to Git admin
	// data under the main repository. Inside a container, that path must still be
	// reachable or Git will fail with:
	//   fatal: not a git repository (or any of the parent directories): .git
	//
	// See .devcontainer/readme.md for the recommended layout and setup steps.
	// ────────────────────────────────────────────────────────────────────────────

	"mounts": [
		// Mount the shared parent directory into the container at the exact same
		// absolute path it has on the host. That keeps the worktree's .git pointer
		// valid inside the container.
		//
		// SECURITY WARNING:
		// The container can see EVERY sibling folder under this parent directory,
		// not just the current worktree. This means all worktrees and the main
		// repository are visible. Prefer a dedicated parent containing ONLY the
		// main repository and its worktrees. Do NOT use a parent that contains
		// unrelated projects, sensitive data, or private repositories.
		//
		// PLATFORM NOTE:
		// This repository officially targets macOS, Linux, and WSL-based Windows.
		// Native Windows path models differ enough that they may require a custom
		// mount strategy instead of mirroring ${localWorkspaceFolder} directly.
		//
		// 'consistency=cached' is primarily a legacy Docker Desktop hint for macOS.
		// It is safe to leave in place on Linux and WSL.
		"source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind,consistency=cached"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				// Add project-specific extensions here when you turn this template into a real project.
			]
		}
	},

	// Runs once after the container is created.
	// Git's safe.directory is path-based, so we add a wildcard entry for the whole
	// sibling set instead of a single directory. We register both the default
	// /workspaces parent path and the mirrored host path parent to cover both ways
	// a user may inspect the repository inside the container.
	"postCreateCommand": "container_parent=\"$(dirname '${containerWorkspaceFolder}')\" && mirrored_parent=\"$(dirname '${localWorkspaceFolder}')\" && git config --global --add safe.directory \"${container_parent}/*\" && git config --global --add safe.directory \"${mirrored_parent}/*\""
}

{
	// Display name shown in VS Code's "Dev Containers" status bar and container picker.
	"name": "ubuntu",

	// Points to the Dockerfile that builds the container image.
	// "context": "." means Docker can access any file in .devcontainer during the build (e.g. to COPY files in).
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},

	// The Linux user VS Code connects as inside the container.
	// "vscode" is the default non-root user in Microsoft's base images.
	// Avoid "root" — it causes file-permission conflicts on bind-mounts and is a security risk.
	"remoteUser": "vscode",

	// ── WORKTREE SETUP ──────────────────────────────────────────────────────────
	// This container is opened from a Git worktree. A worktree stores a .git FILE (not a folder) containing an absolute host path pointing back to the main repository. That path must resolve inside the container too — which is what the "mounts" block below achieves. Without it, every git command fails: "fatal: not a git repository (or any of the parent directories): .git"
	// → Full explanation and background: see readme.md § "Git Worktree Support"
	// ────────────────────────────────────────────────────────────────────────────

	"mounts": [
		// Mounts the entire parent directory into the container at the same absolute path it has on the host.
		// Why: a worktree's .git file stores an absolute host path to the main repository. By mounting the parent directory, we ensure that both the worktree (this folder) and the main repository are accessible at their expected paths.
		// This approach works automatically regardless of what you name your repository folder or worktrees.
		// "consistency=cached" is a legacy Docker/macOS performance hint; it is safe to leave on all platforms.
		//
		// CROSS-PLATFORM NOTE: ${localWorkspaceFolder} works on Windows, macOS, and Linux. VS Code automatically converts paths appropriately for your OS.
		// NO CUSTOMIZATION NEEDED: This configuration works out of the box for GitHub, SSH, and HTTPS remotes.
		"source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind,consistency=cached"
	],

	"customizations": {
		"vscode": {
			"extensions": [
				// Add your project-specific extensions here
				// Example: "esbenp.prettier-vscode" for code formatting
			]
		}
	},

	// Runs once after the container is created.
	// safe.directory: Docker bind-mounts may appear owned by root inside the container even though the active user is 'vscode'. Git blocks operations in such directories unless they are explicitly marked safe. We mark the entire parent directory as safe, which covers both this worktree and the main repository.
	"postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}/.."
}
